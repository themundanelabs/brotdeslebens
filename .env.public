# Loaded only by `npm run build:public` (vite --mode public). Switches
# client.ts to staticClient.ts's static-JSON data source instead of the
# live backend — see staticClient.ts's module docstring. Not present in
# any other build/dev mode, so the admin app is unaffected.
VITE_DATA_MODE=static

# Fine-grained GitHub PAT (Contents: write, restricted to
# themundanelabs/brotdeslebens only) — enables the "Angaben stimmen /
# Angaben falsch" vote buttons to actually submit. Until this is set,
# votes are recorded in the visitor's browser only (see
# src/public/lib/feedback.ts). Accepted risk: this token is embedded in
# the public JS bundle and readable by anyone.
# VITE_FEEDBACK_GH_TOKEN=

# Google Maps JavaScript API key, restricted (HTTP referrer) to
# www.brotdeslebens.ch — powers the public site's Map page.
# VITE_GOOGLE_MAPS_API_KEY=
